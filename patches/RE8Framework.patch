+namespace {
+// Query the current output buffer rather than the desktop size or a fixed list
+// of resolutions. DXGI reports physical render pixels, independent of DPI.
+std::optional<std::array<float, 2>> re8_output_dimensions() {
+    IDXGISwapChain* swapchain = nullptr;
+    if (g_framework->is_dx11()) {
+        const auto& hook = g_framework->get_d3d11_hook();
+        if (hook != nullptr) swapchain = hook->get_swap_chain();
+    } else {
+        const auto& hook = g_framework->get_d3d12_hook();
+        if (hook != nullptr) swapchain = hook->get_swap_chain();
+    }
+    DXGI_SWAP_CHAIN_DESC desc{};
+    if (swapchain == nullptr || FAILED(swapchain->GetDesc(&desc)) ||
+        !re8_patch::display::valid_dimensions(static_cast<float>(desc.BufferDesc.Width), static_cast<float>(desc.BufferDesc.Height))) {
+        return std::nullopt;
+    }
+    return std::array<float, 2>{static_cast<float>(desc.BufferDesc.Width), static_cast<float>(desc.BufferDesc.Height)};
+}
+}
