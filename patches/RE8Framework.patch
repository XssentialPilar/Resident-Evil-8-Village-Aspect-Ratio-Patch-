+#pragma once
+#include <array>
+#include <atomic>
+#include <cstring>
+#include "RE8MapDragPolicy.hpp"
+#include "RE8NativeCursor.hpp"
+
+namespace re8_patch {
+// Translate the user's map-only gesture into the engine's original click/pan
+// buttons. Never move GUI panels, icons, world coordinates or the OS pointer.
+class MapDragController {
+public:
+    static MapDragController& get() { static MapDragController controller; return controller; }
+    void configure(int binding) {
+        m_binding.store(std::clamp(binding, 0, 5));
+        if (g_framework->is_game_data_initialized() && !m_attempted.exchange(true)) {
+            initialize();
+            if (!available()) spdlog::warn("[RE8MapDrag] Required map/input interfaces unavailable; native controls retained");
+        }
+    }
+    bool available() const { return m_available.load(std::memory_order_acquire); }
+    void on_gui_update() {
+        std::scoped_lock lock{m_update_mutex};
+        const int binding = m_binding.load();
+        if (!available() || binding == 0 || g_framework->is_drawing_ui() ||
+            !NativeCursorController::get().game_menu_visible() || !map_showing()) {
+            m_policy.update(false, false, false);
+            m_captured = false;
+            m_frame.store(0);
+            return;
+        }
+        POINT point{};
+        const bool focused = focused_client(point);
+        const bool map_content = available() && binding != 0 && focused &&
+            !g_framework->is_drawing_ui() && pointer_over_map_content(point);
+        const bool held = binding != 0 && (GetAsyncKeyState(virtual_keys[binding]) & 0x8000) != 0;
+        // Once a pan starts, retain capture over fixed panels until release.
+        const bool eligible = map_content || (m_captured && focused &&
+            !g_framework->is_drawing_ui() && map_showing());
+        const bool moved = point.x != m_previous.x || point.y != m_previous.y;
+        const auto frame = m_policy.update(eligible, held, moved);
+        m_captured = frame.dragging;
+        m_previous = point;
+        m_frame.store((frame.eligible ? 1u : 0u) | (frame.held ? 2u : 0u) |
+            (frame.dragging ? 4u : 0u) | (frame.started ? 8u : 0u) | (frame.ended ? 16u : 0u));
+    }
+private:
+    struct Point { float x; float y; };
+    static constexpr std::array<int, 6> virtual_keys{0, VK_LBUTTON, VK_RBUTTON, VK_MBUTTON, VK_XBUTTON1, VK_XBUTTON2};
+    std::atomic<int> m_binding{1};
+    std::atomic<bool> m_attempted{};
+    std::atomic<bool> m_available{};
+    std::atomic<uint32_t> m_frame{};
+    std::array<uint32_t, 6> m_masks{};
+    std::array<std::unique_ptr<FunctionHook>, 3> m_button_hooks;
+    MapDragPolicy m_policy;
+    std::mutex m_update_mutex;
+    POINT m_previous{};
+    bool m_captured{};
+    sdk::REField* m_map_hash{};
+    sdk::REField* m_step{};
+    sdk::REField* m_world{};
+    sdk::REField* m_area{};
+    sdk::REField* m_panel{};
+    std::array<sdk::REField*, 4> m_fixed_panels{};
+    sdk::RETypeDefinition* m_step_type{};
+    sdk::REMethodDefinition* m_find{};
+    sdk::REMethodDefinition* m_driver{};
+    sdk::REMethodDefinition* m_showing{};
+    sdk::REMethodDefinition* m_to_virtual{};
+    sdk::REMethodDefinition* m_hit_test{};
+
+    static bool focused_client(POINT& point) {
+        const auto window = static_cast<HWND>(g_framework->get_window());
+        RECT rectangle{};
+        return window != nullptr && GetForegroundWindow() == window && !IsIconic(window) &&
+            GetCursorPos(&point) && ScreenToClient(window, &point) &&
+            GetClientRect(window, &rectangle) && PtInRect(&rectangle, point);
+    }
+    static sdk::REMethodDefinition* method(sdk::RETypeDefinition* type, const char* name) {
+        auto result = type != nullptr ? type->get_method(name) : nullptr;
+        return result != nullptr && result->get_function() != nullptr ? result : nullptr;
+    }
+    static ::REManagedObject* object_field(sdk::REField* field, ::REManagedObject* object) {
+        const auto data = field != nullptr ? field->get_data_raw(object) : nullptr;
+        return data != nullptr ? *static_cast<::REManagedObject**>(data) : nullptr;
+    }
+    bool map_showing() const {
+        if (!NativeCursorController::get().authorized_menu_visible("Map")) return false;
+        const auto data = m_map_hash != nullptr ? m_map_hash->get_data_raw(nullptr) : nullptr;
+        auto manager = sdk::get_managed_singleton<::REManagedObject>("app.GUIManager");
+        return data != nullptr && manager != nullptr && m_showing != nullptr &&
+            m_showing->call_safe<bool>(sdk::get_thread_context(), manager, *static_cast<const uint32_t*>(data));
+    }
+    bool pointer_over_map_content(POINT point) const {
+        auto manager = sdk::get_managed_singleton<::REManagedObject>("app.GUIManager");
+        const auto hash_data = m_map_hash->get_data_raw(nullptr);
+        const auto handle = m_find->call_safe<::REManagedObject*>(sdk::get_thread_context(), manager,
+            *static_cast<const uint32_t*>(hash_data));
+        if (handle == nullptr) return false;
+        const auto driver = m_driver->call_safe<::REManagedObject*>(sdk::get_thread_context(), handle);
+        if (driver == nullptr || !::REManagedObject::is_managed_object(driver) ||
+            driver->get_type_definition() == nullptr || !driver->get_type_definition()->is_a("app.GUIMap")) return false;
+        const auto step = m_step->get_data_raw(driver);
+        const auto world = m_world->get_data_raw(nullptr);
+        const auto area = m_area->get_data_raw(nullptr);
+        const size_t size = m_step_type->is_value_type() ? m_step_type->get_valuetype_size() : sizeof(void*);
+        if (step == nullptr || world == nullptr || area == nullptr || size == 0 || size > 32 ||
+            (std::memcmp(step, world, size) != 0 && std::memcmp(step, area, size) != 0)) return false;
+        const auto object = reinterpret_cast<REComponent*>(driver)->get_game_object();
+        const auto transform = object != nullptr ? object->get_transform() : nullptr;
+        const auto gui = transform != nullptr ? transform->find<REComponent>("via.gui.GUI") : nullptr;
+        const auto panel = object_field(m_panel, driver);
+        if (gui == nullptr || panel == nullptr) return false;
+        // Use the original GUI conversion, including its view, DPI and scaling.
+        const auto logical = m_to_virtual->call<Point>(sdk::get_thread_context(), gui,
+            Point{static_cast<float>(point.x), static_cast<float>(point.y)});
+        if (!m_hit_test->call<bool>(sdk::get_thread_context(), panel, logical)) return false;
+        for (auto field : m_fixed_panels) {
+            const auto fixed = object_field(field, driver);
+            if (fixed != nullptr && m_hit_test->call<bool>(sdk::get_thread_context(), fixed, logical)) return false;
+        }
+        return true;
+    }
+    uint32_t remap(uint32_t original, MapButtonSample sample) const {
+        const auto bits = m_frame.load();
+        if ((bits & 1u) == 0) return original;
+        POINT point{};
+        const int binding = m_binding.load();
+        if (!available() || binding == 0 || g_framework->is_drawing_ui() || !focused_client(point)) return original;
+        const MapDragFrame frame{(bits & 1u) != 0, (bits & 2u) != 0, (bits & 4u) != 0,
+                                 (bits & 8u) != 0, (bits & 16u) != 0};
+        return map_drag_buttons(original, m_masks[binding], m_masks[1], m_masks[3], sample, frame);
+    }
+    static uint32_t held_hook(void* device) {
+        auto& self = get();
+        return self.remap(self.m_button_hooks[0]->get_original<decltype(held_hook)>()(device), MapButtonSample::Held);
+    }
+    static uint32_t down_hook(void* device) {
+        auto& self = get();
+        return self.remap(self.m_button_hooks[1]->get_original<decltype(down_hook)>()(device), MapButtonSample::Down);
+    }
+    static uint32_t up_hook(void* device) {
+        auto& self = get();
+        return self.remap(self.m_button_hooks[2]->get_original<decltype(up_hook)>()(device), MapButtonSample::Up);
+    }
+    void initialize() {
+        const auto map = sdk::find_type_definition("app.GUIMap");
+        const auto define = sdk::find_type_definition("app.MenuDefine");
+        const auto manager = sdk::find_type_definition("app.GUIManager");
+        const auto handle = sdk::find_type_definition("app.GUIHandle");
+        const auto buttons = sdk::find_type_definition("via.hid.MouseButton");
+        const auto gui = sdk::find_type_definition("via.gui.GUI");
+        const auto control = sdk::find_type_definition("via.gui.Control");
+        m_step_type = sdk::find_type_definition("app.GUIMap.StepType");
+        if (!map || !define || !buttons || !m_step_type) return;
+        m_map_hash = define->get_field("Map"); m_step = map->get_field("<step>k__BackingField");
+        m_panel = map->get_field("<mainPanel>k__BackingField");
+        m_world = m_step_type->get_field("World"); m_area = m_step_type->get_field("Area");
+        m_fixed_panels = {map->get_field("<legendPanel>k__BackingField"), map->get_field("<statusPanel>k__BackingField"),
+            map->get_field("<floorPanel>k__BackingField"), map->get_field("<naviPanel>k__BackingField")};
+        m_find = method(manager, "findGUI(System.UInt32)");
+        m_showing = method(manager, "isShowingGUI(System.UInt32)");
+        m_driver = method(handle, "get_driver");
+        m_to_virtual = method(gui, "getPhysicalToVirtualMousePos(via.Point)");
+        m_hit_test = method(control, "hitTest(via.Point)");
+        if (!m_map_hash || !m_step || !m_panel || !m_world || !m_area || !m_find ||
+            !m_showing || !m_driver || !m_to_virtual || !m_hit_test) return;
+        const std::array<const char*, 6> names{"NONE", "L", "R", "C", "EX0", "EX1"};
+        for (size_t i = 0; i < names.size(); ++i) {
+            const auto field = buttons->get_field(names[i]);
+            const auto data = field != nullptr ? field->get_data_raw(nullptr, true) : nullptr;
+            if (data == nullptr) return;
+            m_masks[i] = *static_cast<const uint32_t*>(data);
+        }
+        const std::array<const char*, 3> getters{"get_Button", "get_ButtonDown", "get_ButtonUp"};
+        const std::array<uintptr_t, 3> callbacks{reinterpret_cast<uintptr_t>(&held_hook),
+            reinterpret_cast<uintptr_t>(&down_hook), reinterpret_cast<uintptr_t>(&up_hook)};
+        std::array<uintptr_t, 3> targets{};
+        for (size_t i = 0; i < targets.size(); ++i) {
+            targets[i] = reinterpret_cast<uintptr_t>(sdk::find_native_method("via.hid.MouseDevice", getters[i]));
+            if (targets[i] == 0) return;
+            for (size_t j = 0; j < i; ++j) if (targets[j] == targets[i]) return;
+            size_t decoded = 0;
+            while (decoded < 5) {
+                hde64s instruction{};
+                const auto length = hde64_disasm(reinterpret_cast<const void*>(targets[i] + decoded), &instruction);
+                if (length == 0 || (instruction.flags & F_ERROR) || instruction.opcode == 0xc2 ||
+                    instruction.opcode == 0xc3 || instruction.opcode == 0xcc || instruction.opcode == 0xe9 ||
+                    instruction.opcode == 0xeb || (instruction.opcode == 0xff && instruction.modrm_reg == 4)) return;
+                decoded += length;
+            }
+        }
+        for (size_t i = 0; i < targets.size(); ++i) {
+            m_button_hooks[i] = std::make_unique<FunctionHook>(targets[i], callbacks[i]);
+            if (!m_button_hooks[i]->create()) return;
+        }
+        m_available.store(true, std::memory_order_release);
+        spdlog::info("[RE8MapDrag] Map-only click/hold mapping initialized; original wheel and map transforms preserved");
+    }
+};
+} // namespace re8_patch
diff --git a/src/mods/re8/RE8MapDragPolicy.hpp b/src/mods/re8/RE8MapDragPolicy.hpp
new file mode 100644
index 0000000..ec456ac
--- /dev/null
+++ b/src/mods/re8/RE8MapDragPolicy.hpp
@@ -0,0 +1,44 @@
+#pragma once
+#include <cstdint>
+
+namespace re8_patch {
+struct MapDragFrame {
+    bool eligible{};
+    bool held{};
+    bool dragging{};
+    bool started{};
+    bool ended{};
+};
+class MapDragPolicy {
+public:
+    MapDragFrame update(bool eligible, bool held, bool moved) {
+        MapDragFrame frame{eligible, eligible && held};
+        if (frame.held) frame.dragging = m_dragging || (m_held && moved);
+        frame.started = frame.dragging && !m_dragging;
+        frame.ended = eligible && !held && m_dragging;
+        m_held = frame.held;
+        m_dragging = frame.dragging;
+        return frame;
+    }
+private:
+    bool m_held{};
+    bool m_dragging{};
+};
+enum class MapButtonSample { Held, Down, Up };
+inline uint32_t map_drag_buttons(uint32_t original, uint32_t assigned, uint32_t left,
+                                 uint32_t center, MapButtonSample sample, MapDragFrame frame) {
+    if (!frame.eligible || assigned == 0 || left == 0 || center == 0) return original;
+    const bool source = (original & assigned) != 0;
+    uint32_t result = original & ~assigned;
+    if (sample == MapButtonSample::Held) {
+        if (frame.held) result |= frame.dragging ? center : left;
+    } else if (sample == MapButtonSample::Down) {
+        if (source && !frame.dragging) result |= left; // Normal click expands/selects.
+        if (frame.started) result |= center; // Begin the engine's own pan gesture.
+    } else {
+        if (source) result |= frame.ended ? center : left;
+        if (frame.ended) result |= center;
+    }
+    return result;
+}
+} // namespace re8_patch
diff --git a/src/mods/re8/RE8NativeCursor.hpp b/src/mods/re8/RE8NativeCursor.hpp
new file mode 100644
index 0000000..a8ed5bc
--- /dev/null
+++ b/src/mods/re8/RE8NativeCursor.hpp
@@ -0,0 +1,487 @@
+#pragma once
+
+#include <algorithm>
+#include <atomic>
+#include <hde64.h>
+#include <mutex>
+#include <vector>
+#include <Windows.h>
+#include <sdk/RETypeDB.hpp>
+#include "../../HookManager.hpp"
+#include "RE8CursorPolicy.hpp"
+
+namespace re8_patch {
+// One owner for policy and Win32 rendering. RE Engine retains its original mouse
+// mode, deltas, drag, wheel and physical/virtual coordinate conversion.
+class NativeCursorController {
+public:
+    static NativeCursorController& get() {
+        static NativeCursorController controller;
+        return controller;
+    }
+
+    void on_frame(bool patch_config_open) {
+        set_patch_config_open(patch_config_open);
+        // Normally one reflection scan after UpdateGUI. If an engine frame omits
+        // that entry (loading/scene transition), reconcile once at Present.
+        if (!m_gui_updated.exchange(false, std::memory_order_relaxed)) update("present-fallback");
+    }
+
+    void on_gui_update() {
+        update("post-UpdateGUI");
+        m_gui_updated.store(true, std::memory_order_relaxed);
+    }
+
+    void update(std::string_view reason = "menu-state") {
+        std::unique_lock lock{m_state_mutex, std::try_to_lock};
+        if (!lock.owns_lock()) return;
+        if (!g_framework->is_game_data_initialized()) return;
+        if (!m_initialized) initialize();
+        if (!m_hooks_ready.load(std::memory_order_acquire)) return;
+        bool visible = false;
+        if (m_query != nullptr) {
+            auto manager = sdk::get_managed_singleton<::REManagedObject>("app.GUIManager");
+            if (manager != nullptr) {
+                for (auto& menu : m_menus) {
+                    // Static readonly menu hashes can be uninitialized at startup.
+                    // Resolve lazily without keeping managed object pointers alive.
+                    const auto data = menu.field->get_data_raw(nullptr);
+                    if (data == nullptr) continue;
+                    const auto hash = *static_cast<const uint32_t*>(data);
+                    if (hash == 0) continue;
+                    const auto showing = m_query->call_safe<bool>(sdk::get_thread_context(), manager, hash);
+                    // Closing remains authoritative through fading/transient
+                    // engine states. Only an explicit open operation resets it.
+                    const bool effective = showing && !menu.closing;
+                    if (m_diagnostics && (showing != menu.last_showing || effective != menu.last_effective)) {
+                        LARGE_INTEGER now{};
+                        QueryPerformanceCounter(&now);
+                        spdlog::info("[RE8NativeCursor] menu-edge qpc={} tid={} name={} hash={:08x} showing={} closing={} effective={} reason={}",
+                            now.QuadPart, GetCurrentThreadId(), menu.field->get_name(), hash,
+                            showing, menu.closing, effective, reason);
+                    }
+                    menu.last_showing = showing;
+                    menu.last_effective = effective;
+                    if (effective) visible = true;
+                }
+            }
+        }
+        publish(visible, reason);
+    }
+
+    void set_patch_config_open(bool open) {
+        std::scoped_lock lock{m_state_mutex};
+        m_patch_config_open.store(open, std::memory_order_relaxed);
+        publish(m_menu_visible.load(std::memory_order_relaxed), "patch-config");
+    }
+
+    bool wants_cursor() const {
+        return m_desired.load(std::memory_order_relaxed);
+    }
+
+    bool game_menu_visible() const {
+        return m_menu_visible.load(std::memory_order_relaxed);
+    }
+
+    bool authorized_menu_visible(std::string_view name) {
+        std::scoped_lock lock{m_state_mutex};
+        for (const auto& menu : m_menus) {
+            if (menu.field->get_name() == name) return menu.last_effective;
+        }
+        return false;
+    }
+
+    // Called from the game's own WndProc. Cursor counter changes must stay on
+    // that thread; rendering/managed callbacks only publish policy and post.
+    bool on_message(HWND window, UINT message, WPARAM wparam, LPARAM lparam) {
+        if (message == m_apply_message && m_apply_message != 0) {
+            m_apply_pending.store(false, std::memory_order_relaxed);
+            apply(window);
+            return true;
+        }
+        if (message == WM_KILLFOCUS || (message == WM_ACTIVATEAPP && !wparam) ||
+            (message == WM_SIZE && wparam == SIZE_MINIMIZED)) {
+            restore_visibility_counter();
+            return false;
+        }
+        if (message == WM_SETCURSOR && LOWORD(lparam) == HTCLIENT &&
+            focused_client(window)) {
+            apply(window);
+            return true;
+        }
+        if (message == WM_SETFOCUS || (message == WM_ACTIVATEAPP && wparam)) {
+            request_apply();
+        }
+        return false;
+    }
+
+    void draw_diagnostics() {
+        std::scoped_lock lock{m_state_mutex};
+        bool diagnostics = m_diagnostics.load(std::memory_order_relaxed);
+        if (ImGui::Checkbox("Record cursor transition diagnostics", &diagnostics))
+            m_diagnostics.store(diagnostics, std::memory_order_relaxed);
+        ImGui::Text("Cursor authority: %s (%zu exact menu IDs)",
+                    m_query != nullptr ? "initialized" : "unavailable; unknown states hidden", m_menus.size());
+        ImGui::Text("Authorized menu visible: %s", m_menu_visible.load() ? "yes" : "no");
+        ImGui::Text("Policy-to-WndProc sample: %.3f ms", m_last_apply_us.load() / 1000.0);
+        ImGui::TextUnformatted("This sample excludes monitor/display latency; runtime checks remain necessary.");
+    }
+
+private:
+    struct MenuState {
+        sdk::REField* field{};
+        bool closing{false};
+        bool last_showing{false};
+        bool last_effective{false};
+    };
+    std::recursive_mutex m_state_mutex;
+    std::vector<MenuState> m_menus;
+    sdk::REMethodDefinition* m_query{};
+    sdk::REField* m_driver_status{};
+    std::vector<std::pair<sdk::REMethodDefinition*, HookManager::HookId>> m_hooks;
+    std::vector<void*> m_hook_entries;
+    std::atomic<bool> m_hooks_ready{false};
+    std::unique_ptr<FunctionHook> m_set_cursor_hook;
+    bool m_initialized{false};
+    std::atomic<bool> m_diagnostics{[] {
+        wchar_t enabled[2]{};
+        return GetEnvironmentVariableW(L"RE8PATCH_CURSOR_DIAGNOSTICS", enabled, 2) == 1 && enabled[0] == L'1';
+    }()};
+    std::atomic<bool> m_gui_updated{false};
+    std::atomic<bool> m_menu_visible{false};
+    std::atomic<bool> m_patch_config_open{false};
+    std::atomic<bool> m_desired{false};
+    std::atomic<bool> m_apply_pending{false};
+    struct PolicyRequest {
+        uint64_t sequence{0};
+        bool visible{false};
+        int64_t requested_qpc{0};
+    };
+    // Pair generation, decision and timestamp atomically. WndProc holds this
+    // tiny lock through the native call so samples cannot mix two transitions.
+    std::mutex m_policy_mutex;
+    PolicyRequest m_policy_request;
+    uint64_t m_last_measured_sequence{0};
+    std::atomic<int64_t> m_last_apply_us{0};
+    UINT m_apply_message{RegisterWindowMessageW(L"RE8Patch.NativeCursor.Apply")};
+    HCURSOR m_arrow{LoadCursorW(nullptr, MAKEINTRESOURCEW(32512))};
+    int m_visibility_adjustments{0}; // Only accessed on the window thread.
+
+    static bool focused_client(HWND window) {
+        if (window == nullptr || GetForegroundWindow() != window || IsIconic(window)) return false;
+        POINT point{};
+        RECT client{};
+        return GetCursorPos(&point) && ScreenToClient(window, &point) &&
+               GetClientRect(window, &client) && PtInRect(&client, point);
+    }
+
+    static HCURSOR WINAPI set_cursor_hook(HCURSOR requested) {
+        auto& self = get();
+        const auto original = self.m_set_cursor_hook->get_original<decltype(set_cursor_hook)>();
+        const auto window = static_cast<HWND>(g_framework->get_window());
+        // Non-client chrome, Alt+Tab, other windows and other applications retain
+        // their own cursor. The hook never changes ShowCursor's counter.
+        if (focused_client(window)) requested = self.wants_cursor() ? self.m_arrow : nullptr;
+        return original(requested);
+    }
+
+    void initialize() {
+        m_initialized = true;
+        const auto set_cursor = GetProcAddress(GetModuleHandleW(L"user32.dll"), "SetCursor");
+        if (set_cursor != nullptr) {
+            m_set_cursor_hook = std::make_unique<FunctionHook>(reinterpret_cast<uintptr_t>(set_cursor),
+                                                            reinterpret_cast<uintptr_t>(&set_cursor_hook));
+            if (!m_set_cursor_hook->create()) {
+                m_set_cursor_hook.reset();
+                spdlog::error("[RE8NativeCursor] SetCursor interception failed; runtime enforcement degraded");
+            }
+        }
+        request_apply();
+
+        const auto define = sdk::find_type_definition("app.MenuDefine");
+        const auto manager = sdk::find_type_definition("app.GUIManager");
+        if (define == nullptr || manager == nullptr) {
+            spdlog::error("[RE8NativeCursor] Required menu metadata absent; unknown states stay hidden");
+            return;
+        }
+        auto query = manager->get_method("isShowingGUI(System.UInt32)");
+        if (query == nullptr) query = manager->get_method("isShowingGUI");
+        if (query == nullptr || query->get_num_params() != 1 || query->get_function() == nullptr ||
+            query->get_return_type() == nullptr || query->get_return_type()->get_full_name() != "System.Boolean" ||
+            query->get_param_types().at(0) == nullptr ||
+            query->get_param_types().at(0)->get_full_name() != "System.UInt32") {
+            spdlog::error("[RE8NativeCursor] GUIManager.isShowingGUI signature unavailable; unknown states stay hidden");
+            return;
+        }
+        m_query = query;
+        for (auto name : authorized_cursor_menus) {
+            auto field = define->get_field(name);
+            if (field != nullptr && field->is_static() && field->get_type() != nullptr &&
+                field->get_type()->get_full_name() == "System.UInt32") {
+                m_menus.push_back({field, false});
+            } else {
+                spdlog::warn("[RE8NativeCursor] Authorized menu field unavailable: {}", name);
+            }
+        }
+        // Hooks use REFramework's metadata-aware dispatcher, never guessed native
+        // calling conventions. Pre-close excludes a fading menu immediately;
+        // post-create/stack transitions reconcile all remaining authorized menus.
+        for (auto name : {"hideGUI", "suicideGUI", "forceSuicideGUI", "createGUI"}) {
+            auto method = manager->get_method(name);
+            if (method == nullptr || method->get_function() == nullptr || method->is_static()) continue;
+            const auto params = method->get_param_types();
+            if (params.empty() || params[0] == nullptr || params[0]->get_full_name() != "System.UInt32") continue;
+            const bool closing = std::string_view{name} != "createGUI";
+            const auto id = add_transition_hook(method,
+                [this, closing, operation = std::string_view{name}](auto& args, auto&, uintptr_t) {
+                    if (args.size() > 2) set_closing(static_cast<uint32_t>(args[2]), closing, operation);
+                    return HookManager::PreHookResult::CALL_ORIGINAL;
+                },
+                [this, operation = std::string_view{name}](uintptr_t&, sdk::RETypeDefinition*, uintptr_t) {
+                    update(std::string{operation} + ".post");
+                });
+            if (id != 0) m_hooks.emplace_back(method, id);
+        }
+        const auto driver_type = sdk::find_type_definition("app.GUIDriver");
+        if (driver_type != nullptr) {
+            m_driver_status = driver_type->get_field("guiStatus");
+            // These entry points also cover reopening a previously created GUI.
+            // Read its typed GUIStatus.hash, never GUI object/display names.
+            for (auto name : {"show", "hide", "suicide"}) {
+                auto method = driver_type->get_method(name);
+                if (method == nullptr || method->get_function() == nullptr || method->is_static()) continue;
+                const auto parameters = method->get_param_types();
+                if (parameters.size() != 1 || parameters[0] == nullptr ||
+                    parameters[0]->get_full_name() != "app.GUIRequest.Parameter" ||
+                    method->get_return_type() == nullptr ||
+                    method->get_return_type()->get_full_name() != "app.GUIDriver.ExecuteResult.Value") continue;
+                const bool closing = std::string_view{name} != "show";
+                const auto id = add_transition_hook(method,
+                    [this, closing, operation = std::string_view{name}](auto& args, auto&, uintptr_t) {
+                        if (args.size() > 1) driver_transition(reinterpret_cast<::REManagedObject*>(args[1]), closing, operation);
+                        return HookManager::PreHookResult::CALL_ORIGINAL;
+                    }, [this, operation = std::string_view{name}](uintptr_t&, sdk::RETypeDefinition*, uintptr_t) {
+                        update(std::string{"driver."} + std::string{operation} + ".post");
+                    });
+                if (id != 0) m_hooks.emplace_back(method, id);
+            }
+        }
+        // Save/load lists have their own reopen command. A reused typewriter
+        // list can call openList without createGUI or GUIDriver.show, so its
+        // previous close exclusion must reset on this real, typed entry point.
+        // Do not authorize SaveLoadFlowManager execution: autosaves use it too.
+        for (auto type_name : {"app.GUISaveLoad", "app.GUISaveDataTransition"}) {
+            const auto save_type = sdk::find_type_definition(type_name);
+            if (save_type == nullptr) continue;
+            const auto method = save_type->get_method("openList");
+            if (method == nullptr || method->get_function() == nullptr || method->is_static()) continue;
+            const auto parameters = method->get_param_types();
+            if (parameters.size() != 1 || parameters[0] == nullptr ||
+                parameters[0]->get_full_name() != "app.GUIRequest.Parameter" ||
+                method->get_return_type() == nullptr ||
+                method->get_return_type()->get_full_name() != "app.GUIDriver.ExecuteResult.Value") continue;
+            const auto id = add_transition_hook(method,
+                [this, save_type, type_name](auto& args, auto&, uintptr_t) {
+                    if (args.size() > 1) {
+                        const auto driver = reinterpret_cast<::REManagedObject*>(args[1]);
+                        if (::REManagedObject::is_managed_object(driver) && driver->get_type_definition() != nullptr &&
+                            driver->get_type_definition()->is_a(save_type)) {
+                            driver_transition(driver, false, std::string{type_name} + ".openList");
+                        }
+                    }
+                    return HookManager::PreHookResult::CALL_ORIGINAL;
+                }, [this, type_name](uintptr_t&, sdk::RETypeDefinition*, uintptr_t) {
+                    update(std::string{type_name} + ".openList.post");
+                });
+            if (id != 0) m_hooks.emplace_back(method, id);
+        }
+        const auto menu_manager = sdk::find_type_definition("app.MenuManager");
+        if (menu_manager != nullptr) {
+            for (auto name : {"pushMenu", "popMenu", "clear"}) {
+                auto method = menu_manager->get_method(name);
+                if (method == nullptr || method->get_function() == nullptr || method->is_static()) continue;
+                const auto params = method->get_param_types();
+                if (std::string_view{name} == "clear") {
+                    if (!params.empty()) continue;
+                } else if (params.size() != 1 || params[0] == nullptr || params[0]->get_full_name() != "System.UInt32") {
+                    continue;
+                }
+                const bool opening = std::string_view{name} == "pushMenu";
+                const auto id = add_transition_hook(method,
+                    [this, opening, operation = std::string_view{name}](auto& args, auto&, uintptr_t) {
+                        if (opening && args.size() > 2) set_closing(static_cast<uint32_t>(args[2]), false, operation);
+                        return HookManager::PreHookResult::CALL_ORIGINAL;
+                    }, [this, operation = std::string_view{name}](uintptr_t&, sdk::RETypeDefinition*, uintptr_t) {
+                        update(std::string{"navigation."} + std::string{operation} + ".post");
+                    });
+                if (id != 0) m_hooks.emplace_back(method, id);
+            }
+        }
+        m_hooks_ready.store(true, std::memory_order_release);
+        spdlog::info("[RE8NativeCursor] Authority initialized: {} menu IDs, {} transition hooks; no coordinate overrides",
+                     m_menus.size(), m_hooks.size());
+        request_apply();
+    }
+
+    HookManager::HookId add_transition_hook(sdk::REMethodDefinition* method,
+                                           HookManager::PreHookFn pre,
+                                           HookManager::PostHookFn post) {
+        const auto entry = method->get_function();
+        if (entry == nullptr || std::find(m_hook_entries.begin(), m_hook_entries.end(), entry) != m_hook_entries.end()) {
+            spdlog::warn("[RE8NativeCursor] Skipping duplicate transition target: {}", method->get_name());
+            return 0;
+        }
+        // RE8 folds unrelated empty managed methods into the same RET stub.
+        // Hooking that stub misinterprets arbitrary callers as a GUI driver.
+        // Also reject existing JMP detours instead of chasing their trampoline.
+        auto instruction = static_cast<const uint8_t*>(entry);
+        size_t decoded = 0;
+        while (decoded < 5) {
+            hde64s decoded_instruction{};
+            const auto length = hde64_disasm(instruction + decoded, &decoded_instruction);
+            const auto opcode = decoded_instruction.opcode;
+            if (length == 0 || (decoded_instruction.flags & F_ERROR) != 0 || opcode == 0xC2 ||
+                opcode == 0xC3 || opcode == 0xCC || opcode == 0xE9 || opcode == 0xEB ||
+                (opcode == 0xFF && decoded_instruction.modrm_reg == 4)) {
+                spdlog::warn("[RE8NativeCursor] Skipping trivial/jump transition target: {} @ {:p}",
+                             method->get_name(), entry);
+                return 0;
+            }
+            decoded += length;
+        }
+        const auto id = g_hookman.add(method,
+            [this, pre = std::move(pre)](auto& args, auto& types, uintptr_t ret) {
+                if (m_hooks_ready.load(std::memory_order_acquire) && pre) return pre(args, types, ret);
+                return HookManager::PreHookResult::CALL_ORIGINAL;
+            },
+            [this, post = std::move(post)](uintptr_t& value, sdk::RETypeDefinition* type, uintptr_t ret) {
+                if (m_hooks_ready.load(std::memory_order_acquire) && post) post(value, type, ret);
+            }, true); // Bind the verified raw entry; never follow a patched JMP.
+        if (id != 0) m_hook_entries.push_back(entry);
+        return id;
+    }
+
+    void driver_transition(::REManagedObject* driver, bool closing, std::string_view operation) {
+        if (driver == nullptr || m_driver_status == nullptr ||
+            !::REManagedObject::is_managed_object(driver) || driver->get_type_definition() == nullptr ||
+            !driver->get_type_definition()->is_a("app.GUIDriver")) return;
+        const auto data = m_driver_status->get_data_raw(driver);
+        if (data == nullptr) return;
+        const auto status = *static_cast<::REManagedObject**>(data);
+        if (status == nullptr || !::REManagedObject::is_managed_object(status) ||
+            status->get_type_definition() == nullptr) return;
+        const auto hash_field = status->get_type_definition()->get_field("<hash>k__BackingField");
+        if (hash_field == nullptr || hash_field->get_type() == nullptr ||
+            hash_field->get_type()->get_full_name() != "System.UInt32") return;
+        const auto hash_data = hash_field->get_data_raw(status);
+        if (hash_data != nullptr) set_closing(*static_cast<const uint32_t*>(hash_data), closing, std::string{"driver."} + std::string{operation});
+    }
+
+    void set_closing(uint32_t hash, bool closing, std::string_view operation) {
+        std::scoped_lock lock{m_state_mutex};
+        bool matched = false;
+        for (auto& menu : m_menus) {
+            const auto data = menu.field->get_data_raw(nullptr);
+            if (data != nullptr && *static_cast<const uint32_t*>(data) == hash) {
+                if (m_diagnostics) {
+                    LARGE_INTEGER now{};
+                    QueryPerformanceCounter(&now);
+                    spdlog::info("[RE8NativeCursor] lifecycle qpc={} tid={} operation={} name={} hash={:08x} closing={} previous_closing={}",
+                        now.QuadPart, GetCurrentThreadId(), operation, menu.field->get_name(), hash,
+                        closing, menu.closing);
+                }
+                menu.closing = closing;
+                matched = true;
+            }
+        }
+        if (matched) update(operation);
+    }
+
+    void publish(bool menu_visible, std::string_view reason) {
+        m_menu_visible.store(menu_visible, std::memory_order_relaxed);
+        const auto desired = should_show_native_cursor(menu_visible,
+            m_patch_config_open.load(std::memory_order_relaxed), true);
+        PolicyRequest request;
+        {
+            std::scoped_lock lock{m_policy_mutex};
+            if (m_desired.load(std::memory_order_relaxed) == desired) return;
+            LARGE_INTEGER now{};
+            QueryPerformanceCounter(&now);
+            m_policy_request = {m_policy_request.sequence + 1, desired, now.QuadPart};
+            m_desired.store(desired, std::memory_order_relaxed);
+            request = m_policy_request;
+        }
+        if (m_diagnostics) {
+            spdlog::info("[RE8NativeCursor] policy seq={} qpc={} tid={} visible={} reason={}",
+                request.sequence, request.requested_qpc, GetCurrentThreadId(), request.visible, reason);
+        }
+        request_apply();
+    }
+
+    void request_apply() {
+        const auto window = static_cast<HWND>(g_framework->get_window());
+        if (window == nullptr || m_apply_message == 0) return;
+        if (GetWindowThreadProcessId(window, nullptr) == GetCurrentThreadId()) {
+            apply(window);
+        } else if (!m_apply_pending.exchange(true, std::memory_order_relaxed)) {
+            // A cross-thread sent notification returns without waiting and is
+            // dispatched ahead of posted/input backlog by the owner's pump.
+            if (!SendNotifyMessageW(window, m_apply_message, 0, 0)) m_apply_pending.store(false);
+        }
+    }
+
+    void restore_visibility_counter() {
+        // Undo exactly our contributions. Never normalize another application's
+        // counter or drive it down once per frame/message.
+        while (m_visibility_adjustments > 0) {
+            ::ShowCursor(FALSE);
+            --m_visibility_adjustments;
+        }
+    }
+
+    void apply(HWND window) {
+        if (!focused_client(window)) {
+            restore_visibility_counter();
+            return;
+        }
+        PolicyRequest applied;
+        int64_t elapsed = -1;
+        int64_t applied_qpc = 0;
+        {
+            std::scoped_lock lock{m_policy_mutex};
+            applied = m_policy_request;
+            const bool show = applied.visible;
+            ::SetCursor(show ? m_arrow : nullptr);
+            if (!show) restore_visibility_counter();
+            if (show) {
+                CURSORINFO info{sizeof(CURSORINFO)};
+                if (GetCursorInfo(&info) && (info.flags & CURSOR_SHOWING) == 0) {
+                    // Bounded, conditional correction; gameplay uses NULL.
+                    for (int attempt = 0; attempt < 32 && m_visibility_adjustments < 32; ++attempt) {
+                        const auto count = ::ShowCursor(TRUE);
+                        ++m_visibility_adjustments;
+                        if (count >= 0) break;
+                    }
+                    if (m_visibility_adjustments == 32 && GetCursorInfo(&info) && (info.flags & CURSOR_SHOWING) == 0) {
+                        spdlog::error("[RE8NativeCursor] Visibility counter correction bound reached; menu cursor requires runtime investigation");
+                    }
+                }
+            }
+            if (applied.requested_qpc != 0 && applied.sequence != m_last_measured_sequence) {
+                LARGE_INTEGER now{}, frequency{};
+                QueryPerformanceCounter(&now);
+                QueryPerformanceFrequency(&frequency);
+                applied_qpc = now.QuadPart;
+                elapsed = (applied_qpc - applied.requested_qpc) * 1000000 / frequency.QuadPart;
+                m_last_measured_sequence = applied.sequence;
+                m_last_apply_us.store(elapsed, std::memory_order_relaxed);
+            }
+        }
+        if (elapsed >= 0 && m_diagnostics) {
+            spdlog::info("[RE8NativeCursor] apply seq={} qpc={} request_qpc={} tid={} visible={} policy_to_apply_us={}",
+                applied.sequence, applied_qpc, applied.requested_qpc, GetCurrentThreadId(), applied.visible, elapsed);
+        }
+    }
+
+};
+}
